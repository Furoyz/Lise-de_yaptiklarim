@{
    ViewData["Title"] = "Dashboard";
}
<h2>Yönetim Paneli</h2>
<p class="text-muted">Soldaki menüden minibüs, durak, tarife ve kullanıcı yönetimine ulaşabilirsin.</p>
<div class="row g-3 mt-3">
    <div class="col-md-4"><a class="btn btn-primary w-100 p-4" asp-controller="Vehicle" asp-action="Index">🚌 Minibüsler</a></div>
    <div class="col-md-4"><a class="btn btn-primary w-100 p-4" asp-controller="Stop" asp-action="Index">📍 Duraklar</a></div>
    <div class="col-md-4"><a class="btn btn-primary w-100 p-4" asp-controller="Schedule" asp-action="Index">🕒 Tarifeler</a></div>
</div>