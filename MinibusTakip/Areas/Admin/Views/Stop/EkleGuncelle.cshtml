@model MinibusTakip.Models.Stop
@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni Durak" : "Durak Düzenle";
}
<h4 class="fw-bold mb-3">@ViewData["Title"]</h4>

<form asp-action="EkleGuncelle" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ResimUrl" /> <!-- Eski resmi korumak için -->

    <div class="admin-card">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Ad" class="form-label text-muted small fw-bold">Durak Adı</label>
            <input asp-for="Ad" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Sira" class="form-label text-muted small fw-bold">Güzergâh Sırası (1, 2, 3...)</label>
            <input asp-for="Sira" class="form-control" type="number" min="1" />
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Durak Resmi</label>
            <input type="file" name="resim" class="form-control" accept="image/*" />
            @if (!string.IsNullOrEmpty(Model.ResimUrl))
            {
                <div class="mt-2">
                    <img src="@Model.ResimUrl" style="height: 100px; border-radius: 12px;" />
                </div>
            }
        </div>

        <button class="btn btn-primary w-100 py-2" type="submit">Kaydet</button>
        <a asp-action="Index" class="btn btn-light w-100 py-2 mt-2">İptal</a>
    </div>
</form>