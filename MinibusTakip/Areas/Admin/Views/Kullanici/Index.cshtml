@model List<MinibusTakip.Models.ApplicationUser>
@{
    ViewData["Title"] = "Kullanıcılar";
    var roller = ViewBag.Roller as Dictionary<string, string> ?? new();
}
<h2>Kullanıcılar</h2>
<p class="text-muted">Şoför olarak atamak istediğin kullanıcıyı "Sofor" rolüne al.</p>
<table class="table table-striped bg-white">
    <thead><tr><th>Ad</th><th>Soyad</th><th>E-posta</th><th>Rol</th><th>Rolü Değiştir</th></tr></thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Ad</td>
                <td>@u.Soyad</td>
                <td>@u.Email</td>
                <td><span class="badge bg-secondary">@roller[u.Id]</span></td>
                <td>
                    <form class="d-flex gap-2" asp-action="RolDegistir" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@u.Id" />
                        <select name="yeniRol" class="form-select form-select-sm">
                            <option value="Yolcu">Yolcu</option>
                            <option value="Sofor">Sofor</option>
                            <option value="Admin">Admin</option>
                        </select>
                        <button class="btn btn-sm btn-primary">Uygula</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>