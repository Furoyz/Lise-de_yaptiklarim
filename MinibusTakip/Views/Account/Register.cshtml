@model MinibusTakip.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="d-flex flex-column justify-content-center mt-4 mb-4">

    <div class="text-center mb-4">
        <h2 class="fw-bold mb-1">Hesap Oluştur</h2>
        <p class="text-muted small">Minibüs Takip sistemine kayıt olun.</p>
    </div>

    <div class="premium-card p-4 mx-auto w-100" style="max-width: 440px;">
        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Ad" class="form-label">Ad</label>
                    <input asp-for="Ad" class="form-control" placeholder="Adınız" />
                    <span asp-validation-for="Ad" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Soyad" class="form-label">Soyad</label>
                    <input asp-for="Soyad" class="form-control" placeholder="Soyadınız" />
                    <span asp-validation-for="Soyad" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">E-posta Adresi</label>
                <input asp-for="Email" class="form-control" placeholder="ornek@email.com" />
                <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Telefon" class="form-label">Telefon (Opsiyonel)</label>
                <input asp-for="Telefon" class="form-control" placeholder="5xx xxx xx xx" />
                <span asp-validation-for="Telefon" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Şifre</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger" style="font-size: 0.8rem;"></span>
                <div class="text-muted mt-1" style="font-size: 0.75rem;">En az 8 karakter, bir büyük harf ve özel karakter içermelidir.</div>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Şifre (Tekrar)</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">Kayıt Ol</button>
        </form>
    </div>

    <div class="text-center mt-4">
        <p class="text-muted" style="font-size: 0.85rem;">
            Zaten hesabınız var mı?
            <a asp-action="Login" class="text-dark fw-bold text-decoration-none ms-1">Giriş Yapın</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}