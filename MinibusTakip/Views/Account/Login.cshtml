@model MinibusTakip.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="d-flex flex-column justify-content-center" style="min-height: 75vh;">

    <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center justify-content-center bg-dark text-white rounded-circle mb-3" style="width: 56px; height: 56px;">
            <i class="fa-solid fa-bus-simple fs-4"></i>
        </div>
        <h2 class="fw-bold mb-1">Tekrar Hoş Geldiniz</h2>
        <p class="text-muted small">Devam etmek için hesabınıza giriş yapın.</p>
    </div>

    <div class="premium-card p-4 mx-auto w-100" style="max-width: 400px;">
        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">E-posta Adresi</label>
                <input asp-for="Email" class="form-control" placeholder="ornek@email.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between">
                    <label asp-for="Password" class="form-label">Şifre</label>
                    <a asp-action="ForgotPassword" class="text-muted text-decoration-none" style="font-size: 0.8rem;">Şifremi Unuttum</a>
                </div>
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input border-secondary" />
                <label asp-for="RememberMe" class="form-check-label text-muted" style="font-size: 0.85rem;"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">Giriş Yap</button>
        </form>
    </div>

    <div class="text-center mt-4">
        <p class="text-muted" style="font-size: 0.85rem;">
            Henüz hesabınız yok mu?
            <a asp-action="Register" class="text-dark fw-bold text-decoration-none ms-1">Hemen Kayıt Olun</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}