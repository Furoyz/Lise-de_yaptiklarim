@{
    ViewData["Title"] = "Şifremi Unuttum";
}
<div class="container mt-4" style="max-width: 480px;">
    <h2>Şifremi Unuttum</h2>
    <p class="text-muted">Kayıtlı e-posta adresinizi girin, size bir sıfırlama linki gönderelim.</p>

    @if (TempData["hata"] != null)
    {
        <div class="alert alert-danger">@TempData["hata"]</div>
    }
    @if (TempData["basari"] != null)
    {
        <div class="alert alert-success">@TempData["basari"]</div>
    }

    <form asp-action="ForgotPassword" method="post">
        <div class="mb-3">
            <label class="form-label">E-posta</label>
            <input type="email" name="email" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary w-100">Sıfırlama Linki Gönder</button>
        <p class="mt-3 text-center"><a asp-action="Login">Giriş sayfasına dön</a></p>
    </form>
</div>