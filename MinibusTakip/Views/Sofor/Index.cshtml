@model MinibusTakip.ViewModels.SoforPanelViewModel
@{
    ViewData["Title"] = "Şoför Paneli";
}

@if (Model.Minibus == null)
{
    <div class="premium-card text-center py-5 mt-4">
        <i class="fa-solid fa-triangle-exclamation fs-1 text-warning mb-3"></i>
        <h5 class="fw-bold">Araç Atanmamış</h5>
        <p class="text-muted small mb-0">Lütfen admin ile iletişime geçin.</p>
    </div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-2">
    <h3 class="fw-bold mb-0">@Model.Minibus.Plaka</h3>
</div>

<div class="premium-card mb-3 border-start border-4 border-success">
    <h6 class="fw-bold mb-2">Canlı Konum Paylaşımı</h6>
    <p class="small text-muted mb-3">Yolcuların sizi haritada görebilmesi için konumu başlatın.</p>
    <button id="btnKonumPaylas" class="btn btn-success w-100 py-3 fw-bold">
        <i class="fa-solid fa-location-arrow me-2"></i> Konum Paylaşımını Başlat
    </button>
</div>

<div class="premium-card mb-3">
    <div class="card-title"><i class="fa-solid fa-circle-info"></i> Anlık Durum</div>
    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
        <span class="text-muted small">Son Durak</span>
        <span class="fw-bold">@(Model.Durum?.SonDurak?.Ad ?? "-")</span>
    </div>
    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
        <span class="text-muted small">Hedef Durak</span>
        <span class="fw-bold">@(Model.Durum?.HedefDurak?.Ad ?? "-")</span>
    </div>
    <div class="d-flex justify-content-between">
        <span class="text-muted small">Durum</span>
        <span class="badge bg-secondary">@(Model.Durum?.Durum ?? "-")</span>
    </div>
</div>

<div class="premium-card mb-3">
    <div class="card-title"><i class="fa-solid fa-clock"></i> Gecikme Bildir</div>
    <form asp-action="GecikmeBildir" method="post" id="gecikmeForm">
        @Html.AntiForgeryToken()
        <div class="row g-2">
            <div class="col-4"><button type="submit" name="dakika" value="5" class="btn btn-outline-secondary w-100 fw-bold">+5 dk</button></div>
            <div class="col-4"><button type="submit" name="dakika" value="10" class="btn btn-outline-secondary w-100 fw-bold">+10 dk</button></div>
            <div class="col-4"><button type="submit" name="dakika" value="15" class="btn btn-outline-secondary w-100 fw-bold">+15 dk</button></div>
        </div>
    </form>
</div>

<div class="premium-card mb-3">
    <div class="card-title"><i class="fa-regular fa-comment-dots"></i> Mesaj Gönder</div>
    <form asp-action="MesajGonder" method="post">
        @Html.AntiForgeryToken()
        <input type="text" name="mesaj" class="form-control mb-2" placeholder="Mesajınız (arıza, yoğunluk...)" required />
        <button class="btn btn-primary w-100">Gönder</button>
    </form>
</div>