@model MinibusTakip.Models.ApplicationUser
@{
    ViewData["Title"] = "Profilim";
    string rol = ViewBag.Rol;
}

<div class="text-center mt-4 mb-4">
    <div class="bg-primary text-white rounded-circle d-inline-flex justify-content-center align-items-center shadow-lg mb-3" style="width: 100px; height: 100px; font-size: 3rem;">
        @(Model.Ad?.FirstOrDefault().ToString().ToUpper() ?? "U")
    </div>
    <h3 class="fw-bold mb-1">@Model.Ad @Model.Soyad</h3>
    <p class="text-muted mb-2">@Model.Email</p>
    <span class="badge bg-secondary px-3 py-2 rounded-pill">@rol</span>
</div>

<div class="app-card mb-4">
    <h5 class="fw-bold mb-3 border-bottom pb-2">İşlemler</h5>

    <!-- Role Göre Buton Gösterimi -->
    @if (rol == "Admin")
    {
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-primary w-100 py-3 mb-3 d-flex align-items-center justify-content-center gap-2">
            <i class="fa-solid fa-user-shield"></i> Admin Paneline Git
        </a>
    }
    else if (rol == "Sofor")
    {
        <a asp-controller="Sofor" asp-action="Index" class="btn btn-primary w-100 py-3 mb-3 d-flex align-items-center justify-content-center gap-2">
            <i class="fa-solid fa-bus"></i> Şoför Paneline Git
        </a>
    }

    <!-- Çıkış Yap Butonu -->
    <form asp-controller="Account" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger w-100 py-3 d-flex align-items-center justify-content-center gap-2">
            <i class="fa-solid fa-arrow-right-from-bracket"></i> Çıkış Yap
        </button>
    </form>
</div>