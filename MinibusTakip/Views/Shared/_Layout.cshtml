@using Microsoft.AspNetCore.Identity
@inject SignInManager<MinibusTakip.Models.ApplicationUser> SignInManager
@inject UserManager<MinibusTakip.Models.ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="theme-color" content="#F8FAFC" />
    <title>@ViewData["Title"] - Minibüs Takip</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- TEK CSS DOSYASI -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Harita sadece burada tanımlı, her sayfaya yüklenmiyor, sayfa yoksa zararı yok -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>
<body>

    <header class="app-header">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <i class="fa-solid fa-bus-simple"></i> Minibüs Takip
        </a>
        <div class="d-flex align-items-center gap-3">
            <button id="themeToggle" class="theme-toggle" title="Tema Değiştir">
                <i class="fa-solid fa-moon"></i>
            </button>
            @if (SignInManager.IsSignedIn(User))
            {
                var user = await UserManager.GetUserAsync(User);
                <a asp-controller="Profil" asp-action="Index" class="text-decoration-none">
                    <div class="avatar-circle">@(user?.Ad?.FirstOrDefault().ToString().ToUpper() ?? "U")</div>
                </a>
            }
        </div>
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    @if (SignInManager.IsSignedIn(User))
    {
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        <nav class="bottom-nav">
            <a asp-controller="Home" asp-action="Index" class="@(controller == "Home" ? "active" : "")">
                <i class="fa-solid fa-house"></i><span>Ana Sayfa</span>
            </a>
            <a asp-controller="Yolcu" asp-action="Panelim" class="@(controller == "Yolcu" ? "active" : "")">
                <i class="fa-solid fa-location-dot"></i><span>Durağım</span>
            </a>
            <a asp-controller="Profil" asp-action="Index" class="@(controller == "Profil" ? "active" : "")">
                <i class="fa-solid fa-user"></i><span>Profil</span>
            </a>
        </nav>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- TEK JS DOSYASI -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- İŞTE EKSİK OLAN VE HATAYI ÇÖZEN SATIR BURADA -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>