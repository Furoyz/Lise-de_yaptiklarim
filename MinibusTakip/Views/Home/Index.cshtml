@using Microsoft.AspNetCore.Identity
@inject SignInManager<MinibusTakip.Models.ApplicationUser> SignInManager
@{
    ViewData["Title"] = "Ana Sayfa";
    var duraklar = ViewBag.Duraklar as List<MinibusTakip.Models.Stop> ?? new List<MinibusTakip.Models.Stop>();
    var minibus = ViewBag.Minibus as MinibusTakip.Models.Vehicle;
    var durum = ViewBag.Durum as MinibusTakip.Models.VehicleStatus;
    var sonrakiSefer = ViewBag.SonrakiSefer as MinibusTakip.Models.Schedule;
}

@if (!SignInManager.IsSignedIn(User))
{
    <!-- GİRİŞ YAPMAMIŞ KULLANICILAR İÇİN KARŞILAMA EKRANI -->
    <div class="d-flex flex-column justify-content-center align-items-center text-center" style="height: 70vh;">
        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center mb-4 shadow-lg" style="width: 100px; height: 100px;">
            <i class="fa-solid fa-bus-simple" style="font-size: 3.5rem;"></i>
        </div>
        <h2 class="fw-extrabold mb-2" style="letter-spacing:-1px;">Minibüs Takip</h2>
        <p class="text-muted mb-5 px-4">İlçenizdeki minibüsleri anlık takip edin, durağınıza ne zaman geleceklerini öğrenin.</p>
        <div class="w-100 px-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100 py-3 mb-3">Giriş Yap</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-light w-100 py-3 border" style="border-radius:16px; font-weight:700;">Hesap Oluştur</a>
        </div>
    </div>
}
else if (User.IsInRole(MinibusTakip.Models.UserRoles.Yolcu) || User.IsInRole(MinibusTakip.Models.UserRoles.Admin))
{
    <!-- YOLCULAR VE ADMİNLER İÇİN DURAK SEÇİM EKRANI -->
    <div class="mb-4 mt-2">
        <h4 class="fw-extrabold mb-1" style="letter-spacing:-0.5px;">Neredesiniz?</h4>
        <p class="text-muted small">Beklediğiniz durağı seçin, minibüsünüzü görün.</p>
    </div>

    <div class="row g-3">
        @foreach (var durak in duraklar)
        {
            <div class="col-6 col-md-4">
                <form asp-controller="Yolcu" asp-action="DurakSec" method="post" class="h-100 m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="stopId" value="@durak.Id" />

                    <button type="submit" class="premium-card w-100 h-100 border-0 p-0 text-start d-flex flex-column" style="overflow: hidden;">

                        <div style="width: 100%; height: 110px; position: relative; background: #e2e8f0;">
                            @if (!string.IsNullOrEmpty(durak.ResimUrl))
                            {
                                <img src="@durak.ResimUrl" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex justify-content-center align-items-center text-primary opacity-50">
                                    <i class="fa-solid fa-location-dot fs-1"></i>
                                </div>
                            }
                            <div class="position-absolute top-0 start-0 bg-white m-2 px-2 py-1 rounded-pill small fw-bold shadow-sm">
                                @durak.Sira. Durak
                            </div>
                        </div>

                        <div class="p-3 bg-white w-100 flex-grow-1 d-flex flex-column justify-content-between">
                            <h6 class="fw-bold text-dark mb-2">@durak.Ad</h6>
                            <small class="text-primary fw-bold d-flex align-items-center gap-1">
                                Seç <i class="fa-solid fa-arrow-right"></i>
                            </small>
                        </div>

                    </button>
                </form>
            </div>
        }
    </div>
}
else if (User.IsInRole(MinibusTakip.Models.UserRoles.Sofor))
{
    <!-- ŞOFÖRLER İÇİN KONTROL PANELİ -->
    <div class="mb-4 mt-2">
        <h4 class="fw-extrabold mb-1" style="letter-spacing:-0.5px;">Hoş Geldiniz Şoför Bey 👋</h4>
        <p class="text-muted small">İyi seferler dileriz.</p>
    </div>

    @if (minibus != null)
    {
        <!-- Plaka Kartı -->
        <div class="premium-card mb-3" style="background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; border: none; box-shadow: 0 8px 24px rgba(37, 99, 235, 0.2);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <small class="opacity-75 text-uppercase fw-bold" style="letter-spacing: 1px;">Atanan Araç</small>
                    <h2 class="fw-extrabold mb-0 mt-1" style="letter-spacing:-1px;">@minibus.Plaka</h2>
                </div>
                <div class="bg-white bg-opacity-25 rounded-circle d-flex justify-content-center align-items-center" style="width: 60px; height: 60px;">
                    <i class="fa-solid fa-bus-simple fs-2"></i>
                </div>
            </div>
        </div>

        <!-- Anlık Durum -->
        <div class="premium-card mb-3">
            <div class="card-title"><i class="fa-solid fa-location-dot"></i> Anlık Durum</div>
            <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                <span class="text-muted small fw-medium">Bulunduğu Durak</span>
                <span class="fw-bold text-dark">@(durum?.SonDurak?.Ad ?? "Belirtilmedi")</span>
            </div>
            <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                <span class="text-muted small fw-medium">Gittiği Durak</span>
                <span class="fw-bold text-dark">@(durum?.HedefDurak?.Ad ?? "Belirtilmedi")</span>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small fw-medium">Araç Durumu</span>
                <span class="badge-custom bg-warning bg-opacity-25 text-warning">@(durum?.Durum ?? "Bilinmiyor")</span>
            </div>
        </div>

        <!-- Sıradaki Görev -->
        @if (sonrakiSefer != null)
        {
            <div class="premium-card mb-4" style="border-left: 4px solid var(--primary);">
                <div class="card-title"><i class="fa-solid fa-clock"></i> Sıradaki Görev</div>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-bold fs-5 text-dark">@sonrakiSefer.Stop?.Ad</div>
                        <div class="text-muted small">Durağına doğru</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary rounded-4 px-3 py-2 text-center">
                        <div class="fw-extrabold fs-4 lh-1" style="letter-spacing:-1px;">@sonrakiSefer.Saat.ToString(@"hh\:mm")</div>
                    </div>
                </div>
            </div>
        }

        <!-- Panele Git Butonu -->
        <a asp-controller="Sofor" asp-action="Index" class="btn btn-primary w-100 py-3 fs-5 rounded-4 shadow-sm" style="font-weight: 700;">
            <i class="fa-solid fa-gauge-high me-2"></i> Şoför Paneline Git
        </a>
    }
    else
    {
        <div class="premium-card text-center py-5 mt-4">
            <i class="fa-solid fa-triangle-exclamation fs-1 text-warning mb-3"></i>
            <h5 class="fw-bold">Araç Atanmamış</h5>
            <p class="text-muted small mb-0">Sisteme kayıtlı bir minibüsünüz bulunmuyor. Lütfen yönetici ile iletişime geçin.</p>
        </div>
    }
}